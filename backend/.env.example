# Copy to .env and fill in. .env is gitignored — never commit real values.

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string.
# Atlas > your cluster > Connect > Drivers > copy the srv URI, then put
# your real password in place of <db_password> and add the db name:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/medbot?retryWrites=true&w=majority
MONGODB_URI=
